<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="650.0" minWidth="1100.0" prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@../styles/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.firstsemfinalproject25.controller.DashboardController">

    <fx:define>
        <ToggleGroup fx:id="navGroup" />
    </fx:define>

    <!-- ================= SIDEBAR (fixed width) ================= -->
    <left>
        <VBox maxWidth="220.0" minWidth="220.0" prefWidth="220.0" spacing="6.0" styleClass="sidebar">
            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
            <children>
                <ImageView fx:id="logoView" fitHeight="100.0" fitWidth="186.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.jpeg" />
                    </image>
                </ImageView>
                <Region minHeight="10.0" prefHeight="10.0" />

                <ToggleButton id="dashboard" fx:id="btnDsh" maxWidth="Infinity" onAction="#onNav" selected="true" styleClass="nav-button" text="Dashboard" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🏠" /></graphic>
                </ToggleButton>
                <ToggleButton id="customer" fx:id="btnCustomer" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Customer" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="👤" /></graphic>
                </ToggleButton>
                <ToggleButton id="bike" fx:id="btnBike" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Bike" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🏍" /></graphic>
                </ToggleButton>
                <ToggleButton id="service" fx:id="btnService" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Service" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🛠" /></graphic>
                </ToggleButton>
                <ToggleButton id="mechanic" fx:id="btnMechanic" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Mechanic" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="👷" /></graphic>
                </ToggleButton>
                <ToggleButton id="spareParts" fx:id="btnSpareParts" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Spare Parts" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="⚙" /></graphic>
                </ToggleButton>
                <ToggleButton id="billing" fx:id="btnPayments" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Billing" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🧾" /></graphic>
                </ToggleButton>
                <ToggleButton id="reports" fx:id="btnReports" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Reports" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="📊" /></graphic>
                </ToggleButton>
                <ToggleButton id="settings" fx:id="btnSettings" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Settings" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="⚙" /></graphic>
                </ToggleButton>

                <Region VBox.vgrow="ALWAYS" />

                <!-- user profile -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="profile-box">
                    <children>
                        <Label styleClass="avatar" text="👤" />
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblUser" styleClass="profile-name" text="Admin" />
                                <Label fx:id="lblRole" styleClass="profile-role" text="Administrator" />
                            </children>
                        </VBox>
                        <Button onAction="#onLogout" styleClass="logout-button" text="⏻" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <!-- ================= CONTENT ================= -->
    <center>
        <StackPane fx:id="contentArea" minHeight="0.0" minWidth="0.0">
            <children>
                <VBox fx:id="dashboardPane" minHeight="0.0" minWidth="0.0" spacing="14.0" styleClass="content">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="12.0" /></padding>
                    <children>

                        <!-- top bar: live date & time -->
                        <HBox alignment="CENTER_RIGHT" minHeight="32.0" spacing="12.0">
                            <children>
                                <Label fx:id="lblDateTime" styleClass="datetime" text="--" />
                                <Button fx:id="btnBell" onAction="#onBell" styleClass="icon-button" text="🔔" />
                            </children>
                        </HBox>

                        <!-- hero banner (fixed height, width follows the window) -->
                        <StackPane maxHeight="170.0" minHeight="170.0" minWidth="0.0" prefHeight="170.0" styleClass="banner">
                            <children>
                                <!-- managed="false": the picture can never push the page wider; the controller binds its size to the banner -->
                                <ImageView fx:id="bannerImage" managed="false" pickOnBounds="true" preserveRatio="false" />
                                <VBox alignment="CENTER_LEFT" maxWidth="420.0" spacing="4.0" StackPane.alignment="CENTER_LEFT">
                                    <padding><Insets left="24.0" /></padding>
                                    <children>
                                        <HBox alignment="BASELINE_LEFT">
                                            <children>
                                                <Label styleClass="welcome" text="Welcome Back, " />
                                                <Label fx:id="lblWelcomeName" styleClass="welcome-name" text="Admin" />
                                                <Label styleClass="welcome-name" text="!" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="welcome-sub" text="Here's what's happening at your garage today." />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="2.0" StackPane.alignment="CENTER_RIGHT">
                                    <padding><Insets right="30.0" /></padding>
                                    <children>
                                        <Label styleClass="tag-line" text="KEEP YOUR BIKE" />
                                        <Label styleClass="tag-big" text="IN TOP SHAPE" />
                                        <Label styleClass="tag-small" text="SERVICE  •  REPAIR  •  RIDE" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- stat cards: 5 EQUAL columns (20% each) -->
                        <GridPane hgap="12.0" minWidth="0.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="20.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="20.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="20.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="20.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="20.0" />
                            </columnConstraints>
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="card" GridPane.columnIndex="0">
                                    <children>
                                        <Label styleClass="stat-icon" text="👥" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Total Customers" />
                                                <Label fx:id="lblTotalCustomers" styleClass="stat-value" text="0" />
                                                <Label fx:id="lblCustomersToday" styleClass="stat-up" text="↑ 0 visited today" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="card" GridPane.columnIndex="1">
                                    <children>
                                        <Label styleClass="stat-icon" text="🏍" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Total Bikes" />
                                                <Label fx:id="lblTotalBikes" styleClass="stat-value" text="0" />
                                                <Label fx:id="lblBikesToday" styleClass="stat-up" text="↑ 0 serviced today" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="card" GridPane.columnIndex="2">
                                    <children>
                                        <Label styleClass="stat-icon" text="🔧" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Pending Jobs" />
                                                <Label fx:id="lblPending" styleClass="stat-value" text="0" />
                                                <Hyperlink onAction="#onViewDetails" styleClass="detail-link" text="View Details" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="card" GridPane.columnIndex="3">
                                    <children>
                                        <Label styleClass="stat-icon" text="⚙" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="In Progress" />
                                                <Label fx:id="lblInProgress" styleClass="stat-value" text="0" />
                                                <Hyperlink onAction="#onViewDetails" styleClass="detail-link" text="View Details" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="card" GridPane.columnIndex="4">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="✔" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Completed Today" />
                                                <Label fx:id="lblCompleted" styleClass="stat-value" text="0" />
                                                <Hyperlink onAction="#onViewDetails" styleClass="detail-link" text="View Details" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>

                        <!-- bottom row: table (grows) + quick actions (fixed 300) -->
                        <HBox minHeight="0.0" minWidth="0.0" spacing="12.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox minWidth="0.0" spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="section-title" text="🏍  Recent Service Jobs" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Hyperlink onAction="#onViewDetails" styleClass="detail-link" text="View All" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="jobsTable" minHeight="0.0" minWidth="0.0" styleClass="jobs-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colNo" prefWidth="40.0" sortable="false" text="#" />
                                                <TableColumn fx:id="colPlate" prefWidth="150.0" text="Number Plate" />
                                                <TableColumn fx:id="colModel" prefWidth="150.0" text="Bike Model" />
                                                <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                                                <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                                            </columns>
                                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox maxWidth="300.0" minWidth="300.0" prefWidth="300.0" spacing="10.0" styleClass="card">
                                    <children>
                                        <Label styleClass="section-title" text="✦  Quick Actions" />
                                        <Button fx:id="btnScan" maxWidth="Infinity" onAction="#onScanPlate" styleClass="quick-primary" text="▣   Scan Number Plate" />
                                        <Button fx:id="btnNewService" maxWidth="Infinity" onAction="#onNewServiceRequest" styleClass="quick-button" text="🔧   New Service Request" />
                                        <Button fx:id="btnAddCustomer" maxWidth="Infinity" onAction="#onAddCustomer" styleClass="quick-button" text="👤   Add Customer" />
                                        <Button fx:id="btnAddBike" maxWidth="Infinity" onAction="#onAddBike" styleClass="quick-button" text="🏍   Add Bike" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>