<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="640.0" prefWidth="1000.0" styleClass="login-root" stylesheets="@../styles/login.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lk.ijse.firstsemfinalproject25.controller.ForgotPasswordController">
    <children>

        <!-- ============ LEFT: branding panel ============ -->
        <StackPane minWidth="500.0" prefWidth="500.0" styleClass="brand-panel">
            <children>
                <ImageView fx:id="bannerImage" fitHeight="640.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="false" />
                <VBox alignment="BOTTOM_LEFT" spacing="4.0" StackPane.alignment="BOTTOM_LEFT">
                    <padding><Insets bottom="48.0" left="40.0" right="40.0" /></padding>
                    <children>
                        <Label styleClass="brand-line" text="LOST YOUR PASSWORD?" />
                        <Label styleClass="brand-big" text="GET BACK IN" />
                        <Label styleClass="brand-small" text="ASK YOUR ADMIN FOR A RESET PIN" />
                    </children>
                </VBox>
            </children>
        </StackPane>

        <!-- ============ RIGHT: reset form ============ -->
        <StackPane styleClass="form-panel" HBox.hgrow="ALWAYS">
            <children>
                <VBox fx:id="resetCard" alignment="CENTER_LEFT" maxWidth="360.0" spacing="4.0">
                    <children>
                        <ImageView fx:id="logoView" fitHeight="50.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="login-title" text="Reset Password" />
                        <Label styleClass="login-sub" text="Enter the PIN your administrator gave you" wrapText="true" />
                        <Region prefHeight="10.0" />

                        <Label styleClass="field-label" text="Username" />
                        <TextField fx:id="txtUsername" promptText="Your username" styleClass="login-field" />

                        <Region prefHeight="2.0" />
                        <Label styleClass="field-label" text="Reset PIN" />
                        <TextField fx:id="txtPin" promptText="6-digit PIN" styleClass="login-field" />

                        <Region prefHeight="2.0" />
                        <Label styleClass="field-label" text="New Password" />
                        <PasswordField fx:id="txtNewPassword" promptText="At least 6 characters" styleClass="login-field" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <ProgressBar fx:id="barStrength" maxWidth="Infinity" prefHeight="6.0" progress="0.0" styleClass="strength-bar" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblStrength" minWidth="50.0" styleClass="hint-label" />
                            </children>
                        </HBox>

                        <Label styleClass="field-label" text="Confirm New Password" />
                        <PasswordField fx:id="txtConfirm" promptText="Re-enter the new password" styleClass="login-field" />
                        <Label fx:id="lblConfirmStatus" minHeight="14.0" styleClass="hint-label" />

                        <Label fx:id="lblError" managed="false" styleClass="error-label" visible="false" wrapText="true" />

                        <Button fx:id="btnReset" defaultButton="true" disable="true" maxWidth="Infinity" onAction="#onResetPassword" styleClass="login-button" text="RESET PASSWORD" />

                        <HBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label styleClass="login-sub" text="Remembered it?" />
                                <Hyperlink onAction="#onBackToLogin" styleClass="forgot-link" text="Back to Sign In" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>
