<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.firstsemfinalproject25.controller.AdminDashboardController">

    <stylesheets>
        <URL value="@../styles/dashboard.css" />
        <URL value="@../styles/admin.css" />
    </stylesheets>

    <fx:define>
        <ToggleGroup fx:id="navGroup" />
    </fx:define>

    <!-- ================= SIDEBAR (every page) ================= -->
    <left>
        <VBox prefWidth="210.0" spacing="6.0" styleClass="sidebar">
            <padding><Insets top="14.0" right="12.0" bottom="14.0" left="12.0" /></padding>
            <children>
                <ImageView fx:id="logoView" fitHeight="70.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                <Label styleClass="super-badge" text="★  SUPER ADMIN" />
                <Region prefHeight="10.0" />

                <ToggleButton id="dashboard" maxWidth="Infinity" onAction="#onNav" selected="true" styleClass="nav-button" text="Dashboard" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🏠" /></graphic>
                </ToggleButton>
                <ToggleButton id="customer" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Customer" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="👤" /></graphic>
                </ToggleButton>
                <ToggleButton id="bike" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Bike" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🏍" /></graphic>
                </ToggleButton>
                <ToggleButton id="service" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Service" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🛠" /></graphic>
                </ToggleButton>
                <ToggleButton id="mechanic" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Mechanic" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="👷" /></graphic>
                </ToggleButton>
                <ToggleButton id="spare_part" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Spare Parts" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="⚙" /></graphic>
                </ToggleButton>
                <ToggleButton id="billing" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Billing" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="🧾" /></graphic>
                </ToggleButton>
                <ToggleButton id="reports" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Reports" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="📊" /></graphic>
                </ToggleButton>
                <ToggleButton id="settings" maxWidth="Infinity" onAction="#onNav" styleClass="nav-button" text="Settings" toggleGroup="$navGroup">
                    <graphic><Label styleClass="nav-icon" text="⚙" /></graphic>
                </ToggleButton>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="profile-box">
                    <children>
                        <Label styleClass="avatar" text="★" />
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblUser" styleClass="profile-name" text="Super Admin" />
                                <Label fx:id="lblRole" styleClass="profile-role" text="Super Admin" />
                            </children>
                        </VBox>
                        <Button onAction="#onLogout" styleClass="logout-button" text="⏻" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <!-- ================= CONTENT ================= -->
    <center>
        <StackPane fx:id="contentArea">
            <children>
                <VBox fx:id="homePane" spacing="14.0" styleClass="content">
                    <padding><Insets top="12.0" right="16.0" bottom="16.0" left="16.0" /></padding>
                    <children>

                        <!-- top bar: live date & time -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Label fx:id="lblDateTime" styleClass="datetime" text="--" />
                            </children>
                        </HBox>

                        <!-- banner -->
                        <StackPane minHeight="130.0" prefHeight="130.0" styleClass="banner">
                            <children>
                                <ImageView fx:id="bannerImage" fitHeight="130.0" fitWidth="900.0" pickOnBounds="true" preserveRatio="false" />
                                <VBox alignment="CENTER_LEFT" maxWidth="520.0" spacing="4.0" StackPane.alignment="CENTER_LEFT">
                                    <padding><Insets left="24.0" /></padding>
                                    <children>
                                        <HBox alignment="BASELINE_LEFT">
                                            <children>
                                                <Label styleClass="welcome" text="Welcome Back, " />
                                                <Label fx:id="lblWelcomeName" styleClass="welcome-name" text="Super Admin" />
                                                <Label styleClass="welcome" text="!" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="welcome-sub" text="Control panel: every page, every role, every password PIN." />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="2.0" StackPane.alignment="CENTER_RIGHT">
                                    <padding><Insets right="30.0" /></padding>
                                    <children>
                                        <Label styleClass="tag-line" text="FULL CONTROL" />
                                        <Label styleClass="tag-big" text="OF YOUR GARAGE" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- live stats -->
                        <HBox spacing="12.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-icon" text="👥" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Total Users" />
                                                <Label fx:id="lblTotalUsers" styleClass="stat-value" text="0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-icon" text="🛡" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Admins" />
                                                <Label fx:id="lblAdmins" styleClass="stat-value" text="0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-icon" text="🧾" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Receptionists" />
                                                <Label fx:id="lblReceptionists" styleClass="stat-value" text="0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-icon" text="🔧" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Mechanics" />
                                                <Label fx:id="lblMechanics" styleClass="stat-value" text="0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="🔑" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="stat-title" text="Active Reset PINs" />
                                                <Label fx:id="lblActivePins" styleClass="stat-value" text="0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- user profile cards -->
                        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="section-title" text="👥  User Profiles" />
                                        <Label fx:id="lblUserCount" styleClass="stat-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearch" prefWidth="220.0" promptText="Search name, username, ID..." styleClass="admin-search" />
                                        <ComboBox fx:id="cmbRoleFilter" prefWidth="140.0" styleClass="admin-combo" />
                                        <Button onAction="#onAddUser" styleClass="top-primary" text="＋  Add User" />
                                        <Button onAction="#onResetPinAll" styleClass="top-button" text="🔑  Reset PIN" />
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="cards-scroll" VBox.vgrow="ALWAYS">
                                    <content>
                                        <FlowPane fx:id="cardsPane" hgap="14.0" styleClass="cards-pane" vgap="14.0">
                                            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0" /></padding>
                                        </FlowPane>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
