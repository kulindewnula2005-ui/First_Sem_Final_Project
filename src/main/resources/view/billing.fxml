<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" minHeight="0.0" minWidth="0.0" spacing="14.0" styleClass="page-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.firstsemfinalproject25.controller.BillingController">
    <stylesheets>
        <URL value="@../styles/bike.css" />
        <URL value="@../styles/billing.css" />
    </stylesheets>
    <fx:define>
        <ToggleGroup fx:id="tabGroup" />
    </fx:define>
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <children>

        <!-- ===== header: title + action buttons ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="page-title" text="Billing &amp; Payments" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRecordPayment" onAction="#onRecordPayment" styleClass="outline-button" text="💳   Record Payment" />
                <Button fx:id="btnGenerateBill" onAction="#onGenerateBill" styleClass="add-button" text="＋   Generate Bill" />
            </children>
        </HBox>

        <!-- ===== summary cards ===== -->
        <GridPane hgap="12.0" minWidth="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
            </columnConstraints>
            <children>
                <VBox maxWidth="Infinity" minWidth="0.0" spacing="2.0" styleClass="sum-card" GridPane.columnIndex="0">
                    <children>
                        <Label styleClass="sum-title" text="Total Billed" />
                        <Label fx:id="lblBilled" styleClass="sum-value" text="Rs. 0.00" />
                        <Label fx:id="lblBilledSub" styleClass="sum-sub" text="0 bills" />
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0.0" spacing="2.0" styleClass="sum-card" GridPane.columnIndex="1">
                    <children>
                        <Label styleClass="sum-title" text="Total Received" />
                        <Label fx:id="lblReceived" styleClass="sum-value, sum-green" text="Rs. 0.00" />
                        <Label fx:id="lblReceivedSub" styleClass="sum-sub" text="0 payments" />
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0.0" spacing="2.0" styleClass="sum-card" GridPane.columnIndex="2">
                    <children>
                        <Label styleClass="sum-title" text="Outstanding" />
                        <Label fx:id="lblOutstanding" styleClass="sum-value, sum-red" text="Rs. 0.00" />
                        <Label fx:id="lblOutstandingSub" styleClass="sum-sub" text="0 unpaid bills" />
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0.0" spacing="2.0" styleClass="sum-card" GridPane.columnIndex="3">
                    <children>
                        <Label styleClass="sum-title" text="Today's Income" />
                        <Label fx:id="lblToday" styleClass="sum-value" text="Rs. 0.00" />
                        <Label fx:id="lblTodaySub" styleClass="sum-sub" text="" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <!-- ===== main card ===== -->
        <VBox minHeight="0.0" minWidth="0.0" spacing="12.0" styleClass="page-card" VBox.vgrow="ALWAYS">
            <children>

                <!-- tabs + search + filter -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <HBox spacing="2.0" styleClass="seg-box">
                            <children>
                                <ToggleButton fx:id="tglBills" onAction="#onTab" selected="true" styleClass="seg-button" text="🧾   Bills" toggleGroup="$tabGroup" />
                                <ToggleButton fx:id="tglPayments" onAction="#onTab" styleClass="seg-button" text="💳   Payments" toggleGroup="$tabGroup" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="search-icon" text="🔍" />
                                <TextField fx:id="txtSearch" onAction="#onSearch" promptText="Search..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSearch" onAction="#onSearch" styleClass="search-button" text="🔍" />
                            </children>
                        </HBox>
                        <ComboBox fx:id="cmbFilter" prefWidth="150.0" styleClass="form-combo" />
                    </children>
                </HBox>

                <!-- the two tables share the same space; the tab switch shows one -->
                <StackPane minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- ===== BILLS (table: bill) ===== -->
                        <TableView fx:id="tblBill" minHeight="0.0" minWidth="0.0" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colBillId" prefWidth="70.0" text="Bill" />
                                <TableColumn fx:id="colBillService" prefWidth="70.0" text="Job" />
                                <TableColumn fx:id="colBillPlate" prefWidth="110.0" text="Number Plate" />
                                <TableColumn fx:id="colBillCustomer" prefWidth="120.0" text="Customer" />
                                <TableColumn fx:id="colBillDate" prefWidth="90.0" text="Date" />
                                <TableColumn fx:id="colBillTotal" prefWidth="100.0" text="Total (Rs.)" />
                                <TableColumn fx:id="colBillPaid" prefWidth="100.0" text="Paid (Rs.)" />
                                <TableColumn fx:id="colBillBalance" prefWidth="100.0" text="Balance (Rs.)" />
                                <TableColumn fx:id="colBillStatus" prefWidth="85.0" text="Status" />
                                <TableColumn fx:id="colBillActions" prefWidth="140.0" sortable="false" text="Actions" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- ===== PAYMENTS (table: payment) ===== -->
                        <TableView fx:id="tblPayment" managed="false" minHeight="0.0" minWidth="0.0" styleClass="data-table" visible="false">
                            <columns>
                                <TableColumn fx:id="colPayId" prefWidth="80.0" text="Payment" />
                                <TableColumn fx:id="colPayBill" prefWidth="80.0" text="Bill" />
                                <TableColumn fx:id="colPayPlate" prefWidth="120.0" text="Number Plate" />
                                <TableColumn fx:id="colPayCustomer" prefWidth="140.0" text="Customer" />
                                <TableColumn fx:id="colPayMethod" prefWidth="120.0" text="Method" />
                                <TableColumn fx:id="colPayDate" prefWidth="100.0" text="Date" />
                                <TableColumn fx:id="colPayAmount" prefWidth="120.0" text="Amount (Rs.)" />
                                <TableColumn fx:id="colPayActions" prefWidth="100.0" sortable="false" text="Actions" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </StackPane>

                <!-- footer: count + pagination -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label fx:id="lblCount" styleClass="page-info" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="paginationBox" alignment="CENTER_RIGHT" spacing="8.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>