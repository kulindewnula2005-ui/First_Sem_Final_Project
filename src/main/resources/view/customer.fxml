<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="0.0" minWidth="0.0" spacing="14.0" styleClass="page-root" stylesheets="@../styles/customer.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.firstsemfinalproject25.controller.CustomerController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <children>

        <!-- ===== header: title + add button ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="page-title" text="Customer Management" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAddCustomer" onAction="#onAddCustomer" styleClass="add-button" text="＋   Add Customer" />
            </children>
        </HBox>

        <!-- ===== main card ===== -->
        <VBox minHeight="0.0" minWidth="0.0" spacing="12.0" styleClass="page-card" VBox.vgrow="ALWAYS">
            <children>

                <!-- search bar -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box">
                    <children>
                        <Label styleClass="search-icon" text="🔍" />
                        <TextField fx:id="txtSearch" onAction="#onSearch" promptText="Search customer by ID, name or phone..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSearch" onAction="#onSearch" styleClass="search-button" text="🔍" />
                    </children>
                </HBox>

                <!-- table -->
                <TableView fx:id="tblCustomer" minHeight="0.0" minWidth="0.0" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="220.0" text="Name" />
                        <TableColumn fx:id="colPhone" prefWidth="170.0" text="Phone" />
                        <TableColumn fx:id="colAddress" prefWidth="260.0" text="Address" />
                        <TableColumn fx:id="colActions" prefWidth="120.0" sortable="false" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- footer: count + pagination -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label fx:id="lblCount" styleClass="page-info" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="paginationBox" alignment="CENTER_RIGHT" spacing="8.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>