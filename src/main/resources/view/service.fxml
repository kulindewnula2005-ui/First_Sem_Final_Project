<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" minHeight="0.0" minWidth="0.0" spacing="14.0" styleClass="page-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.firstsemfinalproject25.controller.ServiceController">
    <stylesheets>
        <URL value="@../styles/bike.css" />
        <URL value="@../styles/service.css" />
    </stylesheets>
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <children>

        <!-- ===== header ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="page-title" text="Service Management" />
            </children>
        </HBox>

        <!-- ===== body: form on the left, jobs on the right ===== -->
        <HBox minHeight="0.0" minWidth="0.0" spacing="14.0" VBox.vgrow="ALWAYS">
            <children>

                <!-- ================= NEW SERVICE REQUEST (your mockup) ================= -->
                <VBox maxWidth="380.0" minWidth="340.0" prefWidth="360.0" spacing="8.0" styleClass="page-card">
                    <children>
                        <Label styleClass="card-title" text="New Service Request" />

                        <Label styleClass="form-label" text="Customer *" />
                        <HBox spacing="8.0">
                            <children>
                                <TextField fx:id="txtCustomer" promptText="Search customer..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnAddCustomer" onAction="#onAddCustomer" styleClass="plus-button" text="＋" />
                            </children>
                        </HBox>

                        <Label styleClass="form-label" text="Bike *" />
                        <HBox spacing="8.0">
                            <children>
                                <TextField fx:id="txtBike" promptText="Search bike (number plate, brand, model)..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnAddBike" onAction="#onAddBike" styleClass="plus-button" text="＋" />
                            </children>
                        </HBox>

                        <Label styleClass="form-label" text="Complaint *" />
                        <TextArea fx:id="txtComplaint" prefRowCount="4" promptText="Enter customer complaint..." styleClass="form-area" wrapText="true" />

                        <Label styleClass="form-label" text="Assign Mechanic" />
                        <ComboBox fx:id="cmbMechanic" maxWidth="Infinity" promptText="Select mechanic..." styleClass="form-combo" />

                        <Label styleClass="form-label" text="Service Type *" />
                        <ComboBox fx:id="cmbType" maxWidth="Infinity" promptText="Select service type..." styleClass="form-combo" />

                        <Label fx:id="lblMessage" managed="false" styleClass="form-error" visible="false" wrapText="true" />

                        <HBox spacing="10.0">
                            <padding><Insets top="6.0" /></padding>
                            <children>
                                <Button fx:id="btnReset" maxWidth="Infinity" onAction="#onReset" styleClass="reset-button" text="Reset" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSave" maxWidth="Infinity" onAction="#onSave" styleClass="save-button" text="Save" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- ================= SERVICE JOBS ================= -->
                <VBox minHeight="0.0" minWidth="0.0" spacing="12.0" styleClass="page-card" HBox.hgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="card-title" text="Service Jobs" />
                                <Region HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="cmbFilter" prefWidth="150.0" styleClass="form-combo" />
                            </children>
                        </HBox>

                        <!-- search bar -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box">
                            <children>
                                <Label styleClass="search-icon" text="🔍" />
                                <TextField fx:id="txtSearch" onAction="#onSearch" promptText="Search by ID, number plate, customer, service or mechanic..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSearch" onAction="#onSearch" styleClass="search-button" text="🔍" />
                            </children>
                        </HBox>

                        <!-- table -->
                        <TableView fx:id="tblService" minHeight="0.0" minWidth="0.0" styleClass="data-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="colPlate" prefWidth="105.0" text="Number Plate" />
                                <TableColumn fx:id="colCustomer" prefWidth="115.0" text="Customer" />
                                <TableColumn fx:id="colType" prefWidth="115.0" text="Service" />
                                <TableColumn fx:id="colMechanic" prefWidth="110.0" text="Mechanic" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                                <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                                <TableColumn fx:id="colActions" prefWidth="80.0" sortable="false" text="Actions" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- footer: count + pagination -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label fx:id="lblCount" styleClass="page-info" text="" />
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox fx:id="paginationBox" alignment="CENTER_RIGHT" spacing="8.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>